<%@ page language="java" pageEncoding="UTF-8" contentType="text/html; charset=UTF-8"
%><%@ taglib uri="http://www.sitepark.com/taglibs/core" prefix="sp"
%>
<sp:set value="Grüße" name="gruss"/>
<div class="übersicht">Höhe und Breite der Fläche: <sp:print name="gruss"/></div>
<div class="größe"><sp:if name="gruss" eq="x">Grüße</sp:if></div>
<sp:if condition="${gruss}">Schöne Grüße</sp:if>
